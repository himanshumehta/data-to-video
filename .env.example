# data-to-video configuration. Copy to .env and fill in what you need.
# Every variable is OPTIONAL: the README demo runs with none of them set.

# --- Narration audio (scripts/narrate.py --tts gemini) -----------------------
# Gemini API key from Google AI Studio. Needed only for real TTS.
GEMINI_API_KEY=your-gemini-api-key
# Optional: use Vertex AI instead (requires `gcloud auth application-default login`).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Optional: override the TTS model.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Publishing (scripts/publish.py --send) ----------------------------------
# Base URL of your social-publisher service. Videos are POSTed to $URL/v1/posts.
SOCIAL_PUBLISHER_URL=http://localhost:8080
# Bearer token for that service, if it requires one.
SOCIAL_PUBLISHER_TOKEN=example-publisher-token

# --- Data and media ----------------------------------------------------------
# Folder of <slug>.json vehicle files (default: sample_data/vehicles).
VEHICLE_DATA_DIR=
# Folder holding the transparent vehicle PNGs referenced by primary_nobg_url
# (default: sample_data/images).
VEHICLE_IMAGE_DIR=
# Folder of pre-generated narration clips, <slug>/<lang>/<slide>.mp3
# (default: sample_data/narration).
PREBAKED_NARRATION_DIR=
# Background music file. No music ships with this repo; without it the video has
# narration and UI clicks only. Alternatively drop tracks into assets/music/.
BGM_PATH=
# Brand hashtag appended to generated descriptions.
BRAND_HASHTAG=#BikeNCars

# --- Remotion gallery (npm run gallery) --------------------------------------
VITE_PORT=5173
