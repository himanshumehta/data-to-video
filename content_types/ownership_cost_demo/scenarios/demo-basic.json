{
  "name": "demo-basic",
  "description": "Open with bikencars.com landing-page reveal, then walk through the ownership-cost calculator with slider drags and the year-by-year breakdown.",
  "steps": [
    {
      "id": "00-intro",
      "action": "goto_and_slow_scroll",
      "url_template": "{base}/?capture=1",
      "scroll_duration_sec": 4.0,
      "settle_ms": 600,
      "post_action_delay_sec": 0.3
    },
    {
      "id": "00-hook",
      "action": "goto",
      "url_template": "{base}/ownership-cost/{slug}?capture=1",
      "wait_for_selector": "#sld-km",
      "scroll_to_after_goto": "#price-card",
      "post_action_delay_sec": 0.8
    },
    {
      "id": "01-slider-km",
      "action": "drag_slider",
      "selector": "#sld-km",
      "to_value": 20000,
      "steps": 60,
      "post_action_delay_sec": 0.5
    },
    {
      "id": "02-slider-years",
      "action": "drag_slider",
      "selector": "#sld-yr",
      "to_value": 7,
      "steps": 60,
      "post_action_delay_sec": 0.5
    },
    {
      "id": "03-slider-city",
      "action": "drag_slider",
      "selector": "#sld-city",
      "to_value": 80,
      "steps": 60,
      "post_action_delay_sec": 0.5
    },
    {
      "id": "04-scroll-breakdown",
      "action": "scroll_to",
      "click_before_selector": "#price-bk-toggle",
      "selector_hint": "click 'Show breakdown' on the banner, then scroll to keep the expanded panel + year-by-year cards visible",
      "selectors": [
        "#price-breakdown",
        "[id*='yearly']",
        "#oe-app-root"
      ],
      "post_action_delay_sec": 0.8
    }
  ]
}
