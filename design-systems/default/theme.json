{
  "name": "default",
  "display_name": "BikeNCars Default \u2014 Zinc Dark",
  "schema_version": "2.0",
  "version": "2.0",
  "author": "bikencars",
  "fonts": {
    "display": "Inter",
    "heading": "Inter",
    "body": "Inter",
    "mono": "SF Mono"
  },
  "colors": {
    "surface": { "1": "#09090b", "2": "#0f0f12", "3": "#18181b", "4": "#27272a", "5": "#3f3f46" },
    "text": { "1": "#f4f4f5", "2": "#a1a1aa", "3": "#71717a", "4": "#52525b" },
    "brand": { "primary": "#4783ff", "secondary": "#f43f5e", "accent": "#10B981" },
    "semantic": { "emerald": "#10B981", "red": "#ef4444", "blue": "#3b82f6", "amber": "#f59e0b", "violet": "#8b5cf6", "orange": "#f97316" }
  },
  "typography": {
    "styles": {
      "hero_title": { "font_role": "display", "weight": 900, "size_pt": 96, "line_height": 1.0, "letter_spacing": -0.03, "text_transform": "uppercase", "color": "colors.text.1" },
      "title": { "font_role": "display", "weight": 800, "size_pt": 72, "line_height": 1.1, "letter_spacing": -0.02, "color": "colors.text.1" },
      "subtitle": { "font_role": "heading", "weight": 700, "size_pt": 44, "line_height": 1.2, "color": "colors.text.2" },
      "heading": { "font_role": "heading", "weight": 700, "size_pt": 36, "line_height": 1.3, "color": "colors.text.1" },
      "body": { "font_role": "body", "weight": 500, "size_pt": 28, "line_height": 1.5, "color": "colors.text.2" },
      "label": { "font_role": "body", "weight": 700, "size_pt": 22, "line_height": 1.4, "letter_spacing": 0.2, "text_transform": "uppercase", "color": "colors.text.3" },
      "caption": { "font_role": "body", "weight": 500, "size_pt": 18, "line_height": 1.4, "color": "colors.text.3" },
      "stat_value": { "font_role": "display", "weight": 800, "size_pt": 56, "line_height": 1.0, "color": "colors.text.1" },
      "stat_label": { "font_role": "body", "weight": 600, "size_pt": 20, "line_height": 1.3, "letter_spacing": 0.15, "text_transform": "uppercase", "color": "colors.text.3" }
    }
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "9": 48, "10": 64 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "full": 9999 },
  "glass": {
    "bg": "rgba(255,255,255,0.03)",
    "border": "rgba(255,255,255,0.06)",
    "bg_heavy": "rgba(255,255,255,0.07)",
    "border_heavy": "rgba(255,255,255,0.10)"
  },
  "logo": {
    "light": "assets/logos/bikencars-v2-light.svg",
    "dark": "assets/logos/bikencars-v2-dark.svg",
    "icon_only": "assets/logos/bikencars-icon.svg",
    "default_variant": "light",
    "placement": {
      "anchor": "top-left",
      "position": { "x": 0.04, "y": 0.03 },
      "size": { "w": 0.15, "h": null }
    },
    "glow": { "enabled": true, "color": "rgba(255,255,255,0.15)", "radius": 40 }
  },
  "cards": {
    "glass": { "background": "rgba(255,255,255,0.05)", "border": "rgba(255,255,255,0.08)", "border_radius": 14, "padding": 20 },
    "elevated": { "background": "rgba(255,255,255,0.07)", "border": "rgba(255,255,255,0.10)", "border_radius": 16, "padding": 24 },
    "stat_pill": { "background": "rgba(255,255,255,0.06)", "border": "rgba(255,255,255,0.08)", "border_radius": 50, "padding": 16 }
  },
  "watermark": {
    "text": "bikencars.com",
    "opacity": 0.15,
    "position": "bottom-right",
    "font_size": 16,
    "font_weight": 600,
    "color": "rgba(255,255,255,0.3)",
    "letter_spacing": 0.1
  },
  "slide_chrome": {
    "slide_number": {
      "position": "top-right",
      "font_size": 28,
      "font_weight": 700,
      "current_color": "rgba(255,255,255,0.4)",
      "total_color": "rgba(255,255,255,0.2)",
      "format": "{current} / {total}"
    },
    "progress_dots": {
      "position": "bottom-center",
      "dot_size": 12,
      "gap": 12,
      "active_color": "#10B981",
      "inactive_color": "#27272a",
      "glow_enabled": true
    }
  },
  "backgrounds": {
    "default": { "kind": "gradient", "colors": ["#0a0a12", "#141428"], "angle_deg": 135 },
    "hero": {
      "kind": "gradient",
      "colors": ["#0a0a14", "#0f1a2e"],
      "angle_deg": 135,
      "glows": [
        { "color": "rgba(16,185,129,0.04)", "position": "top-center", "size": "75% 50%", "opacity": 0.04 },
        { "color": "rgba(59,130,246,0.03)", "position": "bottom-center", "size": "60% 40%", "opacity": 0.03 }
      ]
    },
    "verdict": { "kind": "gradient", "colors": ["#0a0a12", "#0f1f16"], "angle_deg": 180 },
    "solid_surface": { "kind": "solid", "colors": ["#09090b"] }
  },
  "shadows": {
    "vehicle": { "offset_x": 0, "offset_y": 0, "blur": 40, "color": "rgba(255,255,255,0.06)" },
    "element": { "offset_x": 0, "offset_y": 8, "blur": 24, "color": "rgba(0,0,0,0.5)" },
    "glow_text": { "offset_x": 0, "offset_y": 0, "blur": 20, "color": "rgba(255,255,255,0.3)" }
  },
  "text_effects": {
    "gradient_fill": {
      "hero_name": { "colors": ["#ffffff", "rgba(255,255,255,0.7)"], "angle_deg": 180 }
    }
  },
  "glows": {
    "primary_top": { "color": "rgba(16,185,129,0.03)", "position": "top-center", "size": "75% 50%", "opacity": 0.03 },
    "primary_bottom": { "color": "rgba(16,185,129,0.02)", "position": "bottom-center", "size": "60% 40%", "opacity": 0.02 }
  },
  "safe_zones": {
    "igReels": { "top": 0.12, "bottom": 0.08, "left": 0.04, "right": 0.04 },
    "tiktok": { "top": 0.12, "bottom": 0.12, "left": 0.04, "right": 0.04 },
    "ytShorts": { "top": 0.10, "bottom": 0.10, "left": 0.04, "right": 0.04 },
    "fbReels": { "top": 0.10, "bottom": 0.08, "left": 0.04, "right": 0.04 },
    "stories": { "top": 0.14, "bottom": 0.10, "left": 0.04, "right": 0.04 },
    "ytLong": { "top": 0.02, "bottom": 0.02, "left": 0.04, "right": 0.04 },
    "igCarousel": { "top": 0.02, "bottom": 0.04, "left": 0.04, "right": 0.04 }
  },
  "animations": {
    "slide_enter": { "type": "fade-in", "duration_ms": 400, "easing": "ease-out" },
    "slide_exit": { "type": "fade-out", "duration_ms": 300, "easing": "ease-in" },
    "text_enter": { "type": "slide-up", "duration_ms": 500, "easing": "ease-out" },
    "image_motion": { "type": "ken-burns", "duration_ms": 5000, "easing": "linear", "params": { "scale_start": 1.0, "scale_end": 1.05 } }
  },
  "data_viz": {
    "rating_ring": { "ring_width": 10, "gradient_colors": ["#10B981", "#3b82f6"], "track_color": "rgba(255,255,255,0.08)", "label_style": "stat_value", "show_label": true },
    "comparison_bar": { "bar_height": 20, "bar_radius": 10, "active_color": "#10B981", "rival_color": "#3b82f6", "track_color": "#18181b" },
    "stat_counter": { "value_style": "stat_value", "label_style": "stat_label", "animation_duration_ms": 800 }
  },
  "components": {
    "spec_box": { "bg": "colors.surface.3", "border": "colors.surface.4", "radius": "radius.md", "padding": "spacing.5" },
    "badge_tag": { "bg": "rgba(16,185,129,0.15)", "text_color": "colors.semantic.emerald", "radius": "radius.full", "padding_x": "spacing.4", "padding_y": "spacing.2" },
    "bar_chart": { "track_bg": "colors.surface.3", "fill_color": "colors.semantic.emerald", "height": "20", "radius": "radius.sm" },
    "pro_con_item": { "pro_color": "colors.semantic.emerald", "con_color": "colors.semantic.red", "border_width": "3" },
    "rating_circle": { "size": "120", "ring_width": "10", "track_color": "colors.surface.4" },
    "vs_divider": { "color": "colors.surface.4", "width": "2", "label_bg": "colors.surface.3" },
    "color_swatch": { "size": "72", "border_color": "colors.surface.4", "border_width": "2" },
    "comparison_row": { "height": "52", "divider_color": "colors.surface.4" },
    "glass_card": { "bg": "glass.bg", "border": "glass.border", "radius": "radius.lg", "padding": "spacing.6" }
  },
  "score_colors": {
    "thresholds": [
      { "min": 0, "max": 3.9, "color": "#ef4444" },
      { "min": 4.0, "max": 5.9, "color": "#f59e0b" },
      { "min": 6.0, "max": 7.4, "color": "#3b82f6" },
      { "min": 7.5, "max": 8.9, "color": "#10B981" },
      { "min": 9.0, "max": 10.0, "color": "#22d3ee" }
    ]
  },
  "section_colors": {
    "hero": "#0a0a14",
    "performance": "#0f1a2e",
    "pros": "#0a1f1a",
    "cons": "#1f0a0a",
    "competition": "#0f0f2e",
    "owners": "#1a1a0a",
    "variants": "#0f0a1f",
    "verdict": "#0a1f16"
  }
}
